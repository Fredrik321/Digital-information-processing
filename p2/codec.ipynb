    "from pathlib import Path\n",
    "import numpy as np\n",
    "\n",
    "ROOT = Path(\"Bird Speciees Dataset\") \n",
    "\n",
    "data = [\n",
    "    np.array(Image.open(path).convert(\"RGB\"))\n",
    "    for path in sorted(ROOT.glob(\"*\"))\n",
    "    if path.suffix.lower() in [\".jpg\", \".jpeg\"]\n",
    "]\n"
   ]
  }
